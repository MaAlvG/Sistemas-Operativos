#!/bin/bash
if [ "$#" -ne 2 ]; then
    echo "Uso: $0 <directorio> <punto_montaje>"
    exit 1
fi

DIRECTORIO=$1
PUNTO_MONTAJE=$2

# Verificar que el directorio fuente existe
if [ ! -d "$DIRECTORIO" ]; then
    echo "Error: El directorio fuente '$DIRECTORIO' no existe"
    exit 1
fi

# Crear punto de montaje si no existe
mkdir -p "$PUNTO_MONTAJE"

# Verificar que el punto de montaje está vacío
if [ "$(ls -A "$PUNTO_MONTAJE" 2>/dev/null)" ]; then
    echo "Error: El directorio de montaje '$PUNTO_MONTAJE' no está vacío"
    exit 1
fi

echo "Montando BWFS desde '$DIRECTORIO' en '$PUNTO_MONTAJE'..."
./bin/bwfs_impl "$DIRECTORIO" "$PUNTO_MONTAJE" -f -o allow_other

echo "Para desmontar: fusermount -u '$PUNTO_MONTAJE'"
